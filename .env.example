# Auto PDI Environment Configuration

# Flask Secret Key for session encryption
SECRET_KEY=autopdi-super-secret-production-key-2026-secure

# Database Connection (MySQL 8+)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
# Default fallback to sqlite:///autopdi.db if MySQL is unavailable during local development
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/autopdi

# AI Service Configuration
# Leave blank to use deterministic intelligent Hackathon Demo Engine
AI_API_KEY=

# Upload Storage Directory (Absolute or relative path)
UPLOAD_FOLDER=uploads

# Environment
FLASK_ENV=development
DEBUG=True
PORT=5000
